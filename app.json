{
  "expo": {
    "name": "KUDAIBERDI",
    "slug": "kudaiberdi",
    "owner": "kudaiberdiavto",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kudaibergenv2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Найдём мастеров рядом, когда вы отправляете заявку, и покажем дорогу к магазину.",
        "NSMicrophoneUsageDescription": "Скажите голосом, какая запчасть нужна или что случилось с машиной, и отправляйте голосовые в чате.",
        "NSPhotoLibraryUsageDescription": "Прикрепите фото или видео запчасти к запросу, товару или сообщению.",
        "NSCameraUsageDescription": "Сфотографируйте или снимите видео запчасти, чтобы показать продавцу или покупателям."
      },
      "bundleIdentifier": "kg.kudaiberdi.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C44B8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ],
      "package": "kg.kudaiberdi.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#111317"
          }
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Скажите голосом, какая запчасть нужна или что случилось с машиной, и отправляйте голосовые в чате."
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "@maplibre/maplibre-react-native",
      [
        "expo-camera",
        {
          "cameraPermission": "Сфотографируйте или снимите видео запчасти, чтобы показать продавцу или покупателям.",
          "microphonePermission": "Запишите видео запчасти со звуком.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/with-ios-scene-lifecycle",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Найдём мастеров рядом, когда вы отправляете заявку, и покажем дорогу к магазину."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Прикрепите фото или видео запчасти к запросу, товару или сообщению.",
          "cameraPermission": "Сфотографируйте или снимите видео запчасти, чтобы показать продавцу или покупателям.",
          "microphonePermission": "Запишите видео запчасти со звуком."
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "bee2cbfe-80d2-4854-b1fd-25885e7d45c1"
      },
      "router": {}
    }
  }
}
